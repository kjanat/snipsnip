{
	"name": "snipsnip-svelte",
	"version": "0.1.0",
	"private": true,
	"description": "SnipSnip — Markdown web clipper rebuilt natively on WXT + Svelte 5",
	"repository": "kjanat/snipsnip",
	"author": {
		"name": "Kaj Kowalski",
		"url": "https://github.com/kjanat"
	},
	"type": "module",
	"scripts": {
		"bd": "bun --bun run build",
		"build": "bun run build:chrome && bun run build:firefox",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "wxt -b chrome --mv3",
		"dev:firefox": "wxt -b firefox --mv3",
		"postinstall": "wxt prepare",
		"test": "bun test tests/unit",
		"test:all": "bun run test && bun run test:e2e",
		"test:e2e": "bun run build:chrome && playwright test",
		"typecheck": "tsc --noEmit",
		"zip": "wxt zip -b chrome --mv3",
		"zip:firefox": "wxt zip -b firefox --mv3"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.1",
		"@mozilla/readability": "^0.6.0",
		"@types/pdfmake": "^0.3.2",
		"@webext-core/messaging": "^2.3.0",
		"dayjs": "^1.11.20",
		"fflate": "^0.8.2",
		"marked": "^18.0.2",
		"pdfmake": "^0.3.7",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.9.0",
		"@playwright/test": "^1.59.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/bun": "^1.3.12",
		"@types/turndown": "^5.0.6",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-svelte": "^2.0.4",
		"happy-dom": "^20.9.0",
		"playwright": "^1.59.1",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"wxt": "^0.20.25"
	},
	"packageManager": "bun@1.3.12"
}
