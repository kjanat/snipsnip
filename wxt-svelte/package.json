{
	"name": "snipsnip-svelte",
	"version": "0.1.0",
	"private": true,
	"description": "SnipSnip — Markdown web clipper rebuilt natively on WXT + Svelte 5",
	"repository": "kjanat/snipsnip",
	"author": {
		"name": "Kaj Kowalski",
		"url": "https://github.com/kjanat"
	},
	"type": "module",
	"scripts": {
		"build": "bun run build:chrome && bun run build:firefox",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "wxt -b chrome --mv3",
		"dev:firefox": "wxt -b firefox --mv3",
		"postinstall": "wxt prepare",
		"typecheck": "tsc --noEmit",
		"zip": "wxt zip -b chrome --mv3",
		"zip:firefox": "wxt zip -b firefox --mv3"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"@webext-core/messaging": "^2.3.0",
		"marked": "^18.0.2",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@tsconfig/svelte": "^5.0.8",
		"@types/turndown": "^5.0.6",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-svelte": "^2.0.4",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"wxt": "^0.20.25"
	},
	"packageManager": "bun@1.3.12"
}
