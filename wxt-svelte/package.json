{
	"name": "snipsnip",
	"version": "0.1.0",
	"private": true,
	"description": "One-click Markdown web clipper.",
	"repository": "kjanat/snipsnip",
	"author": {
		"name": "Kaj Kowalski",
		"url": "https://github.com/kjanat"
	},
	"type": "module",
	"scripts": {
		"bd": "bun run build",
		"build": "bun run build:chrome & bun run build:firefox & wait",
		"build:chrome": "bunx --bun wxt build -b chrome",
		"build:firefox": "bunx --bun wxt build -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "bun dev:chrome",
		"dev:chrome": "bunx --bun wxt -b chrome",
		"dev:firefox": "bunx --bun wxt -b firefox",
		"postinstall": "bunx --bun wxt prepare; bun check",
		"lint": "eslint .",
		"test": "bun test:unit",
		"test:all": "bun test:unit && bun test:e2e",
		"test:e2e": "bun build:chrome && playwright test",
		"test:unit": "bun test tests/unit",
		"typecheck": "tsc --noEmit",
		"zip": "bun zip:chrome",
		"zip:chrome": "bunx --bun wxt zip -b chrome",
		"zip:firefox": "bunx --bun wxt zip -b firefox"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.1",
		"@dprint/formatter": "^0.5.1",
		"@dprint/markdown": "^0.21.1",
		"@mozilla/readability": "^0.6.0",
		"@types/pdfmake": "^0.3.2",
		"@webext-core/messaging": "^2.3.0",
		"dayjs": "^1.11.20",
		"fflate": "^0.8.2",
		"marked": "^18.0.2",
		"pdfmake": "^0.3.7",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.9.0",
		"@playwright/test": "^1.59.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/bun": "^1.3.13",
		"@types/turndown": "^5.0.6",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-svelte": "^2.0.4",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"happy-dom": "^20.9.0",
		"playwright": "^1.59.1",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.1",
		"wxt": "^0.20.25"
	},
	"packageManager": "bun@1.3.13"
}
