{
	"name": "snipsnip",
	"version": "5.0.0+dev",
	"private": true,
	"repository": "kjanat/snipsnip",
	"author": {
		"name": "Kaj Kowalski",
		"url": "https://github.com/kjanat"
	},
	"type": "module",
	"scripts": {
		"bd": "bun generate:highlights && bun run build && bun fmt",
		"benchmark:popup": "bun src/scripts/benchmark-popup-startup.ts",
		"build": "bun run build:chrome && bun run build:firefox",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"check": "biome check",
		"dev": "wxt -b chrome --mv3",
		"dev:firefox": "wxt -b firefox --mv3",
		"fmt": "dprint fmt",
		"generate:highlights": "bun src/scripts/generate-release-highlights.ts",
		"postinstall": "wxt prepare",
		"lint": "biome lint",
		"test": "bun test",
		"test:all": "bun test && bun test:e2e",
		"test:coverage": "bun test --coverage",
		"test:e2e": "bun run build:chrome && playwright test src/tests/e2e/wxt-smoke.spec.ts",
		"test:e2e:ci": "bun test:e2e",
		"test:e2e:legacy": "bun run build:chrome && playwright test src/tests/e2e/extension.spec.ts src/tests/e2e/notifications.spec.ts src/tests/e2e/batch-processing.spec.ts src/tests/e2e/command-download-regression.spec.ts src/tests/e2e/live-public.spec.ts",
		"test:integration": "bun test src/tests/integration",
		"test:unit": "bun test src/tests/unit",
		"test:verbose": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@happy-dom/global-registrator": "^20.9.0",
		"@playwright/test": "^1.59.1",
		"@types/bun": "^1.3.12",
		"@wxt-dev/auto-icons": "^1.1.1",
		"happy-dom": "^20.9.0",
		"typescript": "^6.0.3",
		"wxt": "^0.20.25"
	},
	"packageManager": "bun@1.3.12",
	"volta": {
		"node": "25.9.0",
		"npm": "11.12.1"
	}
}
