{
	"name": "snipsnip",
	"version": "4.5.0",
	"private": true,
	"scripts": {
		"benchmark:popup": "bun src/scripts/benchmark-popup-startup.js",
		"build": "bun run build:manifests && web-ext build -s src/.build/firefox",
		"build:all": "bun run build && bun run build:chrome",
		"build:chrome": "cd src/.build/chrome && zip -r ../../../dist/snipsnip-chrome-$(node -p \"require('../../manifest.json').version\").zip . -x '*.DS_Store'",
		"build:manifests": "bun run generate:release-highlights && bun src/scripts/generate-browser-manifests.js",
		"build:wxt": "wxt build",
		"build:wxt:firefox": "wxt build -b firefox",
		"dev:wxt": "wxt",
		"dev:wxt:firefox": "wxt -b firefox",
		"fmt": "dprint fmt",
		"generate:release-highlights": "bun src/scripts/generate-release-highlights.js",
		"postinstall": "wxt prepare",
		"lint:js": "eslint --config src/.eslintrc.json --ignore-pattern 'src/background/**' --ignore-pattern 'src/browser-polyfill.min.js' --ignore-pattern 'src/highlight.min.js' --ignore-pattern 'src/popup/lib/**' src",
		"start:androidwin11": "adb connect 127.0.0.1:58526 && web-ext run -s src -t firefox-android --adb-device 127.0.0.1:58526 --firefox-apk org.mozilla.fenix",
		"start:chromedevwin": "web-ext run -s src -t chromium --chromium-binary 'C:\\Program Files\\Google\\Chrome Dev\\Application\\chrome.exe' -u 'https://en.wikipedia.org/wiki/Special:Random' --bc",
		"start:firefoxdeveloper": "web-ext run -s src -f firefoxdeveloperedition -u 'https://en.wikipedia.org/wiki/Special:Random' --bc",
		"start:waveboxwin": "web-ext run -s src -t chromium --chromium-binary %localappdata%/WaveboxApp/Application/wavebox.exe",
		"test": "bun test",
		"test:all": "bun run test && bun run test:e2e",
		"test:coverage": "bun test --coverage",
		"test:e2e": "playwright test --config src/playwright.config.js",
		"test:e2e:ci": "playwright test --config src/playwright.config.js src/tests/e2e/extension.spec.js src/tests/e2e/notifications.spec.js src/tests/e2e/batch-processing.spec.js src/tests/e2e/command-download-regression.spec.js",
		"test:integration": "bun test src/tests/integration",
		"test:unit": "bun test src/tests/unit",
		"test:verbose": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "latest",
		"@playwright/test": "^1.56.1",
		"@types/bun": "latest",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^10.1.8",
		"happy-dom": "latest",
		"typescript": ">=5,<6",
		"web-ext": "^7.4.0",
		"wxt": "^0.20.20"
	},
	"packageManager": "bun@1.3.12"
}
