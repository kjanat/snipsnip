{
	"name": "snipsnip",
	"version": "4.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bd": "bun generate:highlights && bun build",
		"benchmark:popup": "bun src/scripts/benchmark-popup-startup.ts",
		"build": "bun build:chrome & bun build:firefox & wait",
		"build:chrome": "wxt build -b chrome --mv3",
		"build:firefox": "wxt build -b firefox --mv3",
		"dev": "wxt -b chrome --mv3",
		"dev:firefox": "wxt -b firefox --mv3",
		"fmt": "dprint fmt",
		"generate:highlights": "bun src/scripts/generate-release-highlights.ts",
		"postinstall": "wxt prepare",
		"lint:js": "eslint --config src/.eslintrc.json --ignore-pattern 'src/background/**' --ignore-pattern 'src/browser-polyfill.min.js' --ignore-pattern 'src/highlight.min.js' --ignore-pattern 'src/popup/lib/**' src",
		"start:androidwin11": "adb connect 127.0.0.1:58526 && web-ext run -s src -t firefox-android --adb-device 127.0.0.1:58526 --firefox-apk org.mozilla.fenix",
		"start:chromedevwin": "web-ext run -s src -t chromium -u 'https://en.wikipedia.org/wiki/Special:Random' --bc",
		"start:firefoxdeveloper": "web-ext run -s src -f firefoxdeveloperedition -u 'https://en.wikipedia.org/wiki/Special:Random' --bc",
		"start:waveboxwin": "web-ext run -s src -t chromium --chromium-binary %localappdata%/WaveboxApp/Application/wavebox.exe",
		"test": "bun test",
		"test:all": "bun test && bun test:e2e",
		"test:coverage": "bun test --coverage",
		"test:e2e": "bun build:wxt && playwright test --config playwright.config.ts src/tests/e2e/wxt-smoke.spec.ts",
		"test:e2e:ci": "bun test:e2e",
		"test:e2e:legacy": "bun build:wxt && playwright test --config playwright.config.ts src/tests/e2e/extension.spec.ts src/tests/e2e/notifications.spec.ts src/tests/e2e/batch-processing.spec.ts src/tests/e2e/command-download-regression.spec.ts src/tests/e2e/live-public.spec.ts",
		"test:integration": "bun test src/tests/integration",
		"test:unit": "bun test src/tests/unit",
		"test:verbose": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "latest",
		"@playwright/test": "^1.56.1",
		"@types/bun": "latest",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^10.1.8",
		"happy-dom": "latest",
		"typescript": "^6.0.3",
		"web-ext": "^7.4.0",
		"wxt": "^0.20.20"
	},
	"packageManager": "bun@1.3.12"
}
