{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext", // don't change. I NEED YOU TO FUCKING USE MODULE SYNTAX!!!
		"types": ["bun"]
	},
	"include": [
		"src/entrypoints/**/*.ts",
		"src/lib/**/*.ts",
		"src/shared/**/*.ts",
		"src/global.d.ts",
		"wxt.config.ts",
		".wxt/types/**/*.d.ts",
		".wxt/wxt.d.ts"
	],
	"exclude": [
		".output",
		"node_modules",
		"src/background",
		"src/browser-polyfill.min.ts",
		"src/highlight.min.ts",
		"src/service-worker.ts",
		"src/contentScript",
		"src/popup",
		"src/options",
		"src/guide",
		"src/offscreen",
		"src/scripts",
		"src/tests",
		"src/print"
	]
}
