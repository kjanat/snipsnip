{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext", // don't change. I NEED YOU TO FUCKING USE MODULE SYNTAX!!!
		"verbatimModuleSyntax": true,
		"types": ["bun"]
	},
	"include": [
		"src/entrypoints/**/*.ts",
		"src/lib/**/*.ts",
		"src/shared/**/*.ts",
		"src/global.d.ts",
		"src/**/*.ts",
		"wxt.config.ts",
		".wxt/types/**/*.d.ts",
		".wxt/wxt.d.ts"
	],
	"exclude": [".output", "node_modules"]
}
